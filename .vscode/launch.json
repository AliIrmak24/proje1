{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "sozegitim-frontend (Chrome Web)",
            "cwd": "sozegitim-frontend_temel-2",
            "request": "launch",
            "type": "dart",
            "args": ["-d", "chrome"]
        },
        {
            "name": "sozegitim-frontend (Windows Desktop)",
            "cwd": "sozegitim-frontend_temel-2",
            "request": "launch",
            "type": "dart",
            "args": ["-d", "windows"]
        },
        {
            "name": "backend (FastAPI / Uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--app-dir",
                "backend_python"
            ],
            "jinja": true
        }
    ]
}