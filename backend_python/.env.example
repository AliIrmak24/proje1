# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun. .env dosyası git'e eklenmez.

# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Boş bırakılırsa backend_python/sozegitim.db (SQLite) kullanılır.
# Postgres örneği: postgresql://kullanici:sifre@localhost:5432/sozegitim_db
DATABASE_URL=

# Virgülle ayrılmış web adresleri; canlı ortamda "*" yerine gerçek adres yazılmalı
CORS_ORIGINS=*
